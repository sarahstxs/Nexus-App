<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Dynamic background image loaded via Glide (Place) -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <!-- Comparative power information (Team VS Enemy) -->
    <TextView
        android:id="@+id/txtPowerInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"/>

    <!-- Battle result message (Victory or Defeat) -->
    <TextView
        android:id="@+id/txtBattleResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@+id/txtPowerInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="24dp"/>

    <!-- ========================================== -->
    <!-- CONTAINER FOR THE 6 CHOSEN HEROES (ROW 1) -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutBattleTeamTop"
        android:layout_width="330dp"
        android:layout_height="150dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        android:layout_marginBottom="200dp"
        app:layout_constraintBottom_toTopOf="@+id/btnBackToMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp">

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/other_button">
            <ImageView
                android:id="@+id/imgBattleHero1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:background="#222222"
                android:scaleType="centerCrop"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/other_button">
            <ImageView
                android:id="@+id/imgBattleHero2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:background="#222222"
                android:scaleType="centerCrop"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/other_button">
            <ImageView
                android:id="@+id/imgBattleHero3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:background="#222222"
                android:scaleType="centerCrop"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ========================================== -->
    <!-- CONTAINER FOR THE 6 CHOSEN HEROES (ROW 2) -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutBattleTeamTop"
        android:layout_width="330dp"
        android:layout_height="150dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toTopOf="@+id/btnBackToMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp">

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/other_button">
            <ImageView
                android:id="@+id/imgBattleHero4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:background="#222222"
                android:scaleType="centerCrop"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/other_button">
            <ImageView
                android:id="@+id/imgBattleHero5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:background="#222222"
                android:scaleType="centerCrop"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/other_button">
            <ImageView
                android:id="@+id/imgBattleHero6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:background="#222222"
                android:scaleType="centerCrop"/>
        </LinearLayout>



    </LinearLayout>



    <!-- Button to close screen and go back -->
    <Button
        android:id="@+id/btnBackToMenu"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:text="Back to Menu"
        android:fontFamily="@font/bebasbeue_regular"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="20dp"
        android:textColor="#FFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="40dp"
        android:background="@drawable/other_button"/>

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bebasbeue_regular"
        android:text="Your deck"
        android:textColor="#ee9b00"
        android:textSize="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="301dp" />

</androidx.constraintlayout.widget.ConstraintLayout>