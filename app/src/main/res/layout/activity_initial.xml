<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e9d8a6"
    tools:context=".ui.activity.InitialActivity">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="0dp"
        android:background="#000000"
        tools:layout_editor_absoluteX="20dp"
        tools:layout_editor_absoluteY="20dp"/>

    <com.example.nexusappxml.ui.view.CustomNavBarView
        android:id="@+id/nav_bar_customizada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.example.nexusappxml.ui.view.PerfilPreviewView
        android:id="@+id/user_preview_component"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.nexusappxml.ui.view.CoinView
        android:id="@+id/coin_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.nexusappxml.ui.view.GoBattleButton
        android:id="@+id/btn_go_battle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="112dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.426"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:text="Level 37"
        android:textColor="#ee9b00"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="@font/bebasbeue_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="50dp"
        android:layout_height="10dp"
        android:layout_marginTop="180dp"
        android:background="#ee9b00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="50dp"
        android:layout_height="10dp"
        android:layout_marginTop="180dp"
        android:layout_marginEnd="110dp"
        android:background="#9b2226"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="50dp"
        android:layout_height="10dp"
        android:layout_marginStart="110dp"
        android:layout_marginTop="180dp"
        android:background="#005f73"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Container do Preview do Deck e dos 6 Heróis -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerDeckPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="250dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Herói 1 -->
        <ImageView
            android:id="@+id/imgHero1"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:background="#111111"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Herói 2 -->
        <ImageView
            android:id="@+id/imgHero2"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:layout_marginStart="6dp"
            android:background="#111111"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="@id/imgHero1"
            app:layout_constraintStart_toEndOf="@id/imgHero1" />

        <!-- Herói 3 -->
        <ImageView
            android:id="@+id/imgHero3"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:layout_marginStart="6dp"
            android:background="#111111"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="@id/imgHero1"
            app:layout_constraintStart_toEndOf="@id/imgHero2" />

        <!-- Herói 4 -->
        <ImageView
            android:id="@+id/imgHero4"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:layout_marginTop="6dp"
            android:background="#111111"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toBottomOf="@id/imgHero1"
            app:layout_constraintStart_toStartOf="@id/imgHero1" />

        <!-- Herói 5 -->
        <ImageView
            android:id="@+id/imgHero5"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:background="#111111"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toBottomOf="@id/imgHero1"
            app:layout_constraintStart_toEndOf="@id/imgHero4" />

        <!-- Herói 6 -->
        <ImageView
            android:id="@+id/imgHero6"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:background="#111111"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toBottomOf="@id/imgHero1"
            app:layout_constraintStart_toEndOf="@id/imgHero5" />

        <!-- Botão para Gerenciar o Deck -->
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>